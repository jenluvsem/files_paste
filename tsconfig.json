{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "node",
		"strict": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": false,
		"jsx": "preserve",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"types": ["vitest/globals"]
	},
	"include": ["src/**/*", "tests/**/*"],
	"exclude": ["node_modules", "build", "vendor"]
}
